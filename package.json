{
  "name": "vanilla-match-height",
  "version": "2.3.0",
  "license": "MIT",
  "author": "Simone Miterangelis <simone@mite.it>",
  "description": "a vanilla responsive equal heights",
  "main": "dist/vanilla-match-height.js",
  "module": "dist/vanilla-match-height.mjs",
  "types": "dist/vanilla-match-height.d.ts",
  "exports": {
    ".": {
      "types": "./dist/vanilla-match-height.d.ts",
      "import": "./dist/vanilla-match-height.mjs",
      "require": "./dist/vanilla-match-height.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.cjs"
    },
    "./dist/vanilla-match-height": "./dist/vanilla-match-height.js",
    "./dist/vanilla-match-height.min": "./dist/vanilla-match-height.min.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/vanilla-match-height.js",
    "./dist/vanilla-match-height.min.js",
    "./dist/vanilla-match-height.mjs"
  ],
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitera/vanilla-match-height.git"
  },
  "keywords": [
    "matchHeight",
    "equal",
    "match",
    "height",
    "equalize",
    "columns"
  ],
  "bugs": {
    "url": "https://github.com/mitera/vanilla-match-height/issues"
  },
  "homepage": "https://github.com/mitera/vanilla-match-height#readme",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc --build && tsc -p tsconfig.check.json && node scripts/build.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
